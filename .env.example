# آدرس اتصال به PostgreSQL (فرمت psycopg، بدون "+psycopg")
# اگر رمز شما کاراکتر خاص دارد، آن را URL-encode کنید (مثلاً @ ← %40)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecommerce_db

# کلید امضای توکن JWT؛ حداقل ۳۲ کاراکتر تصادفی
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# اختیاری: اندازه‌ی pool کانکشن‌ها (مقدار پیش‌فرض: ۱ و ۱۰)
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
